# ============================================================
# Modèle de configuration BACKEND
# ------------------------------------------------------------
# 1) Copier ce fichier vers « backend/.env »
# 2) Remplacer chaque valeur « change-me… » par une vraie valeur
# 3) NE JAMAIS committer « backend/.env » (il est ignoré par Git)
# ============================================================

NODE_ENV=development
PORT=3001

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=change-me

DB_DATABASE=luxury_car_rental

# --- Sécurité ---
# JWT_SECRET doit contenir AU MOINS 32 caractères (validation zod).
# Générer par ex. : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-random-secret-of-at-least-32-characters

# --- Scripts de démonstration ---
# Autorise les scripts de seed destructifs. Laisser à false par défaut.
ALLOW_DESTRUCTIVE_DEMO_SEED=false
