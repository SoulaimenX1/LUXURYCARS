    {
      "name": "2. Handover (écrit en base)",
      "item": [
        {
          "name": "Admin — Démarrer une location confirmée",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/rentals/admin/start",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "rentals",
                "admin",
                "start"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reservationNumber\": \"{{reservationNumber}}\",\n  \"mileageKm\": 12000,\n  \"fuelLevelPct\": 80,\n  \"overallCondition\": \"good\",\n  \"notes\": \"V\\u00e9rification Postman, uniquement en base de test\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "const r=pm.response.json();",
                  "pm.test(\"Contrat et location\",()=>{pm.expect(r.id).to.be.a(\"string\");pm.expect(r.contractNumber).to.be.a(\"string\");});",
                  "if(r.id){pm.collectionVariables.set(\"rentalId\",r.id);}"
                ]
              }
            }
          ]
        },
        {
          "name": "Refuser un second démarrage",
