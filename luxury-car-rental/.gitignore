# ============================================================
# Luxury Car Rental — règles d'exclusion Git (racine)
# ============================================================

# --- Dépendances -------------------------------------------------
node_modules/
**/node_modules/

# --- Secrets / environnement ------------------------------------
# Ne jamais versionner de secrets réels. Le modèle .env.example
# (sans valeurs sensibles) est la seule référence versionnée.
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# --- Sorties de build -------------------------------------------
dist/
build/
out/
.next/
**/.next/
coverage/
**/coverage/
*.tsbuildinfo
next-env.d.ts

# --- Logs --------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Système / éditeurs -----------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# --- Tests / rapports -------------------------------------------
playwright-report/
test-results/
blob-report/
playwright/.cache/
